          "http": {
            "method": "POST",
            "url": "https://heartbeat.1komma5grad.com/api/v1/admin/products",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new product"
        },
        {
          "info": {
            "name": "Get a single product by ID",
            "type": "http"
