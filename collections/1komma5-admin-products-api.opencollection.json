              {
                "name": "canbesold",
                "value": "",
                "type": "query",
                "description": "Filter by can be sold status"
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query",
                "description": "Field to sort by"
              },
              {
                "name": "sortOrder",
                "value": "",
                "type": "query",
                "description": "Sort order"
              }
            ]
