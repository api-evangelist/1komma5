          "http": {
            "method": "GET",
            "url": "https://heartbeat.1komma5grad.com/api/v1/admin/products/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a single product by ID"
