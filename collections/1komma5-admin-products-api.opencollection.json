            "method": "GET",
            "url": "https://heartbeat.1komma5grad.com/api/v1/admin/products",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (1-based)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search by product name"
              },
              {
                "name": "categoryId",
                "value": "",
                "type": "query",
                "description": "Filter by category ID"
              },
              {
                "name": "brandId",
                "value": "",
                "type": "query",
                "description": "Filter by brand ID"
              },
              {
                "name": "countryId",
                "value": "",
                "type": "query",
                "description": "Filter by country ID (only for global admins)"
              },
              {
                "name": "public",
                "value": "",
                "type": "query",
                "description": "Filter by visibility (public)"
